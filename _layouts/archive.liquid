---
layout: page
---
<div class="archive-list">
  {% assign archive_items = page.posts | default: page.documents %}
  {% for item in archive_items %}
    <article>
      <h2><a href="{{ item.url | relative_url }}">{{ item.title }}</a></h2>
      {% if item.description %}<p>{{ item.description }}</p>{% endif %}
    </article>
  {% endfor %}
</div>
